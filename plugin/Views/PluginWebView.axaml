<shad:ShadWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:webview2="clr-namespace:MioKit.Webview2;assembly=MioKit.Webview2"
    xmlns:shad="https://github.com/tiny-isle/Ti.Avalonia.Shadcn"
    xmlns:mio="https://github.com/tiny-isle/MioKit"
    Title="模拟按键"
    Width="1080"
    Height="720"
    MinWidth="820"
    MinHeight="560"
    CanPin="True"
    WindowStartupLocation="CenterScreen"
    x:Class="KeySender.Views.PluginWebView">
    <Interaction.Behaviors>
        <mio:PluginWindowBehavior Type="com.tinyisle.plugin.key-sender" />
    </Interaction.Behaviors>

    <webview2:MioWebview2 x:Name="WebView" />
</shad:ShadWindow>
